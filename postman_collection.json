{
  "info": {
    "_postman_id": "c1f7b8e1-512a-4a24-9b55-6b45a66a1a11",
    "name": "Sunucu Uygulama Geliştirme - İlaç ve Hasta Gözlem API",
    "description": "Sunucu Uygulama Geliştirme dersi için hazırlanan tam test koleksiyonu. Tüm CRUD operasyonları, filtreleme, sayfalama, RAG ve 400, 401, 403, 404 hata senaryolarını içerir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "admin123",
      "type": "string"
    },
    {
      "key": "doctorUsername",
      "value": "doktor1",
      "type": "string"
    },
    {
      "key": "doctorPassword",
      "value": "doktor123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. İlaç İşlemleri (Medication CRUD & Filter)",
      "item": [
        {
          "name": "1.1 İlaçları Listele (GET)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/medications", "host": ["{{baseUrl}}"], "path": ["api", "medications"] }
          }
        },
        {
          "name": "1.2 İlaç Arama, Filtreleme ve Sayfalama (GET /search)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/medications/search?name=Parol&page=0&size=10&sortBy=name&sortDirection=ASC",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medications", "search"],
              "query": [
                { "key": "name", "value": "Parol" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sortBy", "value": "name" },
                { "key": "sortDirection", "value": "ASC" }
              ]
            }
          }
        },
        {
          "name": "1.3 Tekil İlaç Getir (GET)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/medications/1", "host": ["{{baseUrl}}"], "path": ["api", "medications", "1"] }
          }
        },
        {
          "name": "1.4 Yeni İlaç Ekle (POST - ADMIN)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Parol\",\n  \"activeIngredient\": \"Parasetamol\",\n  \"dosage\": \"500mg\",\n  \"description\": \"Hafif ve orta siddetli agri kesici ve ates dusurucu tablet.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/medications", "host": ["{{baseUrl}}"], "path": ["api", "medications"] }
          }
        },
        {
          "name": "1.5 İlaç Tam Güncelleme (PUT - ADMIN)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Parol Plus\",\n  \"activeIngredient\": \"Parasetamol + Kafein\",\n  \"dosage\": \"500mg/30mg\",\n  \"description\": \"Guclendirilmis formul agri kesici tablet.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/medications/1", "host": ["{{baseUrl}}"], "path": ["api", "medications", "1"] }
          }
        },
        {
          "name": "1.6 İlaç Kısmi Güncelleme (PATCH - ADMIN)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dosage\": \"1000mg\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/medications/1", "host": ["{{baseUrl}}"], "path": ["api", "medications", "1"] }
          }
        },
        {
          "name": "1.7 İlaç Silme (DELETE - ADMIN)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/medications/1", "host": ["{{baseUrl}}"], "path": ["api", "medications", "1"] }
          }
        }
      ]
    },
    {
      "name": "2. Gözlem Notu İşlemleri (ObservationNote)",
      "item": [
        {
          "name": "2.1 Tüm Gözlem Notlarını Listele (GET)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/notes", "host": ["{{baseUrl}}"], "path": ["api", "notes"] }
          }
        },
        {
          "name": "2.2 Yeni Gözlem Notu Oluştur (POST - DOCTOR)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noteContent\": \"Hasta ilaci tok karnina gunde iki defa alacak. 3 gun sonra kontrol planlandi.\",\n  \"medicationId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/notes", "host": ["{{baseUrl}}"], "path": ["api", "notes"] }
          }
        },
        {
          "name": "2.3 Gözlem Notunu Güncelle (PUT - Kayıt Sahibi Doktor)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noteContent\": \"Guncel not: Hastanin atesi dustu, tedavi dozajinda degisiklik yapilmadi.\",\n  \"medicationId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/notes/1", "host": ["{{baseUrl}}"], "path": ["api", "notes", "1"] }
          }
        },
        {
          "name": "2.4 Gözlem Notunu Sil (DELETE - Kayıt Sahibi Doktor)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/notes/1", "host": ["{{baseUrl}}"], "path": ["api", "notes", "1"] }
          }
        }
      ]
    },
    {
      "name": "3. Hata Senaryoları (400, 404, 401, 403)",
      "item": [
        {
          "name": "3.1 400 Bad Request - Geçersiz İlaç Ekleme (Boş İsim)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"   \",\n  \"activeIngredient\": \"Test\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/medications", "host": ["{{baseUrl}}"], "path": ["api", "medications"] }
          }
        },
        {
          "name": "3.2 400 Bad Request - PATCH ile ID Değiştirme Teşebbüsü",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 999,\n  \"name\": \"Yeni Isim\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/medications/1", "host": ["{{baseUrl}}"], "path": ["api", "medications", "1"] }
          }
        },
        {
          "name": "3.3 404 Not Found - Olmayan Kayıt İsteği (ID: 99999)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/medications/99999", "host": ["{{baseUrl}}"], "path": ["api", "medications", "99999"] }
          }
        },
        {
          "name": "3.4 401 Unauthorized - Hatalı Parola ile İstek",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "yanlis_parola", "type": "string" }
              ]
            },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/medications", "host": ["{{baseUrl}}"], "path": ["api", "medications"] }
          }
        },
        {
          "name": "3.5 403 Forbidden - Doktorun İlaç Silmeye Çalışması",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/medications/1", "host": ["{{baseUrl}}"], "path": ["api", "medications", "1"] }
          }
        }
      ]
    },
    {
      "name": "4. Yapay Zekâ (RAG Soru-Cevap)",
      "item": [
        {
          "name": "4.1 İlaç Yan Etkisi Sorma (POST /api/ai/ask)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicationName\": \"Parol\",\n  \"question\": \"Parol ilacının yan etkileri nelerdir?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ai/ask", "host": ["{{baseUrl}}"], "path": ["api", "ai", "ask"] }
          }
        },
        {
          "name": "4.2 İlaç Dozu Sorma (POST /api/ai/ask)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicationName\": \"Aspirin\",\n  \"question\": \"Aspirin yetişkinlerde kullanım dozu ne kadardır?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ai/ask", "host": ["{{baseUrl}}"], "path": ["api", "ai", "ask"] }
          }
        }
      ]
    },
    {
      "name": "5. Actuator Sağlık ve Bilgi",
      "item": [
        {
          "name": "5.1 Actuator Health (GET)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{doctorUsername}}", "type": "string" },
                { "key": "password", "value": "{{doctorPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        },
        {
